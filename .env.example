# PHANToM GRID :: OpenCode Match 3 AgentWorkflow Environment Template
# Zero-Leak Policy Enforced: Never commit actual API credentials

# System Configuration
PHANTOM_ENV=production
LOG_LEVEL=INFO
ASCII_LOGGING=1

# Hardware Safety Boundaries (ASIL-D Standard)
MAX_VRAM_GB=50.0
ESTOP_ON_MELTDOWN=1
DAMPING_FACTOR=1.35
MAX_TORQUE_NM=85.0

# Zero Data Residue (ZDR) Memory Scrubbing
ZDR_PURGE_PASSES=2
WORM_RECEIPT_ENABLED=1
